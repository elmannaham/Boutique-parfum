# ============================================================================
# SITE CONFIGURATION
# ============================================================================
NEXT_PUBLIC_SITE_URL=https://maison-maeta.com
NEXT_PUBLIC_SITE_NAME=Maison Maeta
NODE_ENV=production

# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/maison_maeta
DATABASE_POOL_SIZE=20

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
NEXTAUTH_URL=https://maison-maeta.com
NEXTAUTH_SECRET=your-super-secret-key-generate-with-openssl-rand-hex-32

# OAuth Providers (optional)
GITHUB_ID=your_github_oauth_app_id
GITHUB_SECRET=your_github_oauth_app_secret
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# JWT & Session
JWT_SECRET=your-jwt-secret-key
SESSION_MAX_AGE=2592000  # 30 days in seconds

# ============================================================================
# PAYMENT PROCESSING (Stripe)
# ============================================================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_test_xxx

# ============================================================================
# EMAIL SERVICE (Resend or similar)
# ============================================================================
RESEND_API_KEY=re_xxx
EMAIL_FROM_ADDRESS=noreply@maison-maeta.com
EMAIL_FROM_NAME=Maison Maeta

# ============================================================================
# CDN & STORAGE (Cloudinary or similar)
# ============================================================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================================================
# ANALYTICS & MONITORING
# ============================================================================
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-xxx
SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_ENVIRONMENT=production

# ============================================================================
# API & EXTERNAL SERVICES
# ============================================================================
NEXT_PUBLIC_API_BASE_URL=https://api.maison-maeta.com
EXTERNAL_API_KEY=your_external_api_key

# Shipping & Logistics
SHIPPO_API_KEY=your_shippo_api_key

# ============================================================================
# FEATURE FLAGS
# ============================================================================
NEXT_PUBLIC_ENABLE_REVIEWS=true
NEXT_PUBLIC_ENABLE_WISHLIST=true
NEXT_PUBLIC_ENABLE_GIFT_CARDS=false
NEXT_PUBLIC_MAINTENANCE_MODE=false

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================
DEBUG=false
VERBOSE_LOGGING=false

# ============================================================================
# SECURITY HEADERS
# ============================================================================
# Content Security Policy directives
CSP_ENABLED=true
CSP_REPORT_URI=https://maison-maeta.report-uri.com/r/default/csp/enforce

# ============================================================================
# RATE LIMITING & CACHE
# ============================================================================
REDIS_URL=redis://localhost:6379
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# ============================================================================
# WORKER ENVIRONMENT (if using edge functions)
# ============================================================================
DURABLE_OBJECT_NAMESPACE=MAISON_MAETA_CACHE
