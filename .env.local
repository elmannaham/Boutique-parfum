# ============================================================================
# DEVELOPMENT ENVIRONMENT VARIABLES
# ⚠️ NEVER commit this file to version control
# ============================================================================

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Maison Maeta
NODE_ENV=development

# Database (SQLite for development, no external setup needed)
DATABASE_URL=file:./prisma/dev.db

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-secret-key-change-in-production-use-openssl-rand-hex-32

# Optional: OAuth Providers (leave empty for now)
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT
JWT_SECRET=dev-jwt-secret-key-change-in-production

# Payments (Stripe test keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_dev
STRIPE_SECRET_KEY=sk_test_dev
STRIPE_WEBHOOK_SECRET=whsec_test_dev

# Email Service (Resend - optional for development)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@maison-maeta.dev
EMAIL_FROM_NAME=Maison Maeta

# CDN & Storage (Cloudinary - optional for development)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Analytics (optional for development)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
EXTERNAL_API_KEY=

# Feature Flags
NEXT_PUBLIC_ENABLE_REVIEWS=true
NEXT_PUBLIC_ENABLE_WISHLIST=true
NEXT_PUBLIC_ENABLE_GIFT_CARDS=false
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Debugging
DEBUG=false
VERBOSE_LOGGING=false
